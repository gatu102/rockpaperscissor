import tkinter as tk
from tkinter import messagebox
import random
import os
from collections import Counter

HIGH_SCORE_FILE = "rps_gui_highscore.txt"


# ----------- Utility Functions -----------
def load_high_score():
    """Load saved high score from file."""
    if os.path.exists(HIGH_SCORE_FILE):
        try:
            with open(HIGH_SCORE_FILE, "r") as f:
                return int(f.read())
        except ValueError:
            return 0
    return 0


def save_high_score(score):
    """Save current high score."""
    with open(HIGH_SCORE_FILE, "w") as f:
        f.write(str(score))


# ----------- Game Class -----------
class RPSGame:
    def __init__(self, root):
        self.root = root
        self.root.title("🎮 Rock Paper Scissors Showdown")
        self.root.geometry("420x450")
        self.root.resizable(False, False)

        # Core game variables
        self.choices = ["Rock", "Paper", "Scissors"]
        self.emojis = {"Rock": "🪨", "Paper": "📄", "Scissors": "✂️"}
        self.wins = 0
        self.losses = 0
        self.ties = 0
        self.high_score = load_high_score()
        self.player_history = []
        self.ai_level = tk.StringVar(value="Easy")

        self.build_ui()

    # ----------- UI Setup -----------
    def build_ui(self):
        tk.Label(self.root, text="🎯 Rock Paper Scissors", font=("Arial", 18, "bold")).pack(pady=10)

        # Difficulty Selection
        tk.Label(self.root, text="AI Difficulty:", font=("Arial", 12)).pack()
        tk.OptionMenu(self.root, self.ai_level, "Easy", "Medium", "Hard").pack(pady=5)

        # Info Label
        self.label_info = tk.Label(self.root, text="Make your move!", font=("Arial", 14))
        self.label_info.pack(pady=10)

        # Buttons Frame
        frame_buttons = tk.Frame(self.root)
        frame_buttons.pack(pady=5)
        for choice in self.choices:
            tk.Button(
                frame_buttons,
                text=f"{self.emojis[choice]} {choice}",
                font=("Arial", 14),
                width=10,
                height=2,
                command=lambda c=choice: self.play(c)
            ).pack(side="left", padx=5)

        # Result Display
        self.label_result = tk.Label(self.root, text="", font=("Arial", 13), wraplength=380, justify="center")
        self.label_result.pack(pady=10)

        # Scoreboard
        self.label_score = tk.Label(self.root, text=self.get_score_text(), font=("Arial", 12, "bold"))
        self.label_score.pack(pady=5)

        # Reset Button
        tk.Button(self.root, text="🔄 Reset Game", font=("Arial", 12), command=self.reset_game).pack(pady=10)

    # ----------- Game Logic -----------
    def get_score_text(self):
        return f"Wins: {self.wins} | Losses: {self.losses} | Ties: {self.ties} | 🏆 High Score: {self.high_score}"

    def counter_move(self, move):
        """Return the move that beats the given one."""
        beats = {"Rock": "Paper", "Paper": "Scissors", "Scissors": "Rock"}
        return beats[move]

    def computer_choice(self):
        """AI chooses based on difficulty level."""
        level = self.ai_level.get()

        if level == "Easy":
            return random.choice(self.choices)

        elif level == "Medium":
            if not self.player_history or random.random() < 0.5:
                return random.choice(self.choices)
            return self.counter_move(self.player_history[-1])

        elif level == "Hard":
            if not self.player_history:
                return random.choice(self.choices)
            most_common = Counter(self.player_history).most_common(1)[0][0]
            return self.counter_move(most_common)

    def play(self, player_choice):
        """Handle one round of play."""
        self.player_history.append(player_choice)
        comp_choice = self.computer_choice()

        # Determine result
        if player_choice == comp_choice:
            result = "🤝 It's a tie!"
            self.ties += 1
        elif (player_choice == "Rock" and comp_choice == "Scissors") or \
             (player_choice == "Paper" and comp_choice == "Rock") or \
             (player_choice == "Scissors" and comp_choice == "Paper"):
            result = "🎉 You win!"
            self.wins += 1
        else:
            result = "💀 You lose!"
            self.losses += 1

        # Update high score
        if self.wins > self.high_score:
            self.high_score = self.wins
            save_high_score(self.high_score)

        # Update labels
        self.label_result.config(
            text=f"You chose {self.emojis[player_choice]} {player_choice}.\n"
                 f"Computer chose {self.emojis[comp_choice]} {comp_choice}.\n\n{result}"
        )
        self.label_score.config(text=self.get_score_text())

    # ----------- Reset -----------
    def reset_game(self):
        """Reset the game stats."""
        confirm = messagebox.askyesno("Reset Game", "Are you sure you want to reset scores?")
        if confirm:
            self.wins = self.losses = self.ties = 0
            self.player_history.clear()
            self.label_result.config(text="")
            self.label_score.config(text=self.get_score_text())
            self.label_info.config(text="Make your move!")


# ----------- Main -----------
if __name__ == "__main__":
    root = tk.Tk()
    app = RPSGame(root)
    root.mainloop()
