import tkinter as tk
from tkinter import simpledialog, messagebox
import random, os
from collections import Counter

LEADERBOARD_FILE = "rps_leaderboard.txt"

# ------------------ Leaderboard ------------------
def load_leaderboard():
    if not os.path.exists(LEADERBOARD_FILE):
        return []
    leaderboard = []
    with open(LEADERBOARD_FILE) as f:
        for line in f:
            try:
                name, score = line.strip().split(",")
                leaderboard.append((name, int(score)))
            except:
                continue
    return sorted(leaderboard, key=lambda x: x[1], reverse=True)

def save_leaderboard(name, score):
    leaderboard = load_leaderboard()
    leaderboard.append((name, score))
    leaderboard.sort(key=lambda x: x[1], reverse=True)
    with open(LEADERBOARD_FILE, "w") as f:
        for n, s in leaderboard[:5]:  # keep top 5
            f.write(f"{n},{s}\n")

# ------------------ Game Class ------------------
class RPSGame:
    def __init__(self, root):
        self.root = root
        self.root.title("🎮 Rock Paper Scissors Showdown")
        self.choices = ["Rock", "Paper", "Scissors"]
        self.emojis = {"Rock":"🪨","Paper":"📄","Scissors":"✂️"}
        self.ai_level = tk.StringVar(value="Easy")

        self.reset_game()
        self.create_widgets()
        self.show_leaderboard()

    # ------------------ UI ------------------
    def create_widgets(self):
        tk.Button(self.root, text="Start Tournament", command=self.start_tournament).pack(pady=5)
        tk.Label(self.root, text="Select AI Difficulty:", font=("Arial", 12)).pack(pady=5)
        tk.OptionMenu(self.root, self.ai_level, "Easy", "Medium", "Hard").pack(pady=5)

        self.label_info = tk.Label(self.root, text="Choose your move!", font=("Arial", 14))
        self.label_info.pack(pady=10)

        frame = tk.Frame(self.root); frame.pack(pady=5)
        for choice in self.choices:
            tk.Button(frame, text=f"{self.emojis[choice]} {choice}", width=10, height=2,
                      font=("Arial",12), command=lambda c=choice: self.play(c)).pack(side="left", padx=5)

        self.label_result = tk.Label(self.root, text="", font=("Arial", 12)); self.label_result.pack(pady=10)
        self.label_score = tk.Label(self.root, text=self.get_score_text(), font=("Arial", 12)); self.label_score.pack(pady=10)
        self.label_leaderboard = tk.Label(self.root, text="", font=("Arial", 12)); self.label_leaderboard.pack(pady=10)
        tk.Button(self.root, text="Reset Game", command=self.reset_game).pack(pady=10)

    # ------------------ Core Logic ------------------
    def reset_scores(self):
        self.wins = self.losses = self.ties = 0
        self.player_history = []

    def reset_game(self):
        self.reset_scores()
        self.current_round = 0
        self.rounds = 0
        self.tournament_mode = False
        self.player_name = ""
        self.label_result = getattr(self, "label_result", tk.Label(self.root))
        self.label_result.config(text="")
        self.label_score = getattr(self, "label_score", tk.Label(self.root))
        self.label_score.config(text=self.get_score_text())
        self.show_leaderboard()

    def get_score_text(self):
        return f"Wins: {self.wins} | Losses: {self.losses} | Ties: {self.ties} | Round: {self.current_round}/{self.rounds if self.tournament_mode else '-'}"

    def computer_choice(self):
        level = self.ai_level.get()
        if level == "Easy" or not self.player_history:
            return random.choice(self.choices)
        if level == "Medium":
            return self.counter_move(self.player_history[-1]) if random.random() > 0.5 else random.choice(self.choices)
        if level == "Hard":
            most_common = Counter(self.player_history).most_common(1)[0][0]
            return self.counter_move(most_common)

    def counter_move(self, move):
        return {"Rock":"Paper", "Paper":"Scissors", "Scissors":"Rock"}[move]

    def play(self, player_choice):
        if self.tournament_mode and self.current_round >= self.rounds:
            return messagebox.showinfo("Tournament Over", "Tournament finished. Start a new tournament.")

        self.player_history.append(player_choice)
        computer_choice = self.computer_choice()
        result = ""
        if player_choice == computer_choice:
            result = "It's a tie!"; self.ties += 1
        elif (player_choice, computer_choice) in [("Rock","Scissors"),("Paper","Rock"),("Scissors","Paper")]:
            result = "🎉 You win!"; self.wins += 1
        else:
            result = "💀 You lose!"; self.losses += 1

        self.current_round += 1
        self.label_result.config(text=f"You chose {self.emojis[player_choice]} {player_choice}.\nComputer chose {self.emojis[computer_choice]} {computer_choice}.\n{result}")
        self.label_score.config(text=self.get_score_text())

        if self.tournament_mode and self.current_round == self.rounds:
            self.end_tournament()

    # ------------------ Tournament ------------------
    def start_tournament(self):
        self.player_name = simpledialog.askstring("Name", "Enter your name:") or "Player"
        try: self.rounds = int(simpledialog.askstring("Rounds", "Enter number of rounds:"))
        except: self.rounds = 5
        self.tournament_mode = True
        self.current_round = 0
        self.reset_scores()
        self.label_result.config(text=f"Tournament started for {self.player_name} - {self.rounds} rounds!")
        self.label_score.config(text=self.get_score_text())

    def end_tournament(self):
        messagebox.showinfo("Tournament Finished", f"Tournament Over!\nWins: {self.wins} | Losses: {self.losses} | Ties: {self.ties}")
        save_leaderboard(self.player_name, self.wins)
        self.show_leaderboard()

    # ------------------ Leaderboard ------------------
    def show_leaderboard(self):
        leaderboard = load_leaderboard()
        text = "🏆 Leaderboard (Top 5 Wins)\n" + "\n".join(f"{i+1}. {n} - {s}" for i,(n,s) in enumerate(leaderboard[:5]))
        self.label_leaderboard.config(text=text)

# ------------------ Run ------------------
if __name__ == "__main__":
    root = tk.Tk()
    RPSGame(root)
    root.mainloop()
